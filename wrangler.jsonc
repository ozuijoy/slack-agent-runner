{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slack-agent-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Slack and GitHub reach the Worker on its workers.dev address.
  "workers_dev": true,
  // The web UI's own host, a custom domain on a zone in your Cloudflare account (README, "Web UI").
  // Cloudflare Access cannot cover only /ui on workers.dev, so the UI lives here instead. `npm run
  // setup` writes it from UI_HOST, for example [{ "pattern": "agent.example.com", "custom_domain": true }].
  "routes": [],
  "observability": { "enabled": true },

  // One object per Slack thread. It is the lock that keeps one Claude turn running per thread, and
  // its alarm is the thread's clock: it retries a job the queue refused, and notices a turn that
  // stopped without a reply. Turns themselves run on your machine (runner/README.md).
  "durable_objects": { "bindings": [{ "name": "THREADS", "class_name": "ThreadState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ThreadState"] }],

  // Slack wants an answer in 3 seconds. The events route answers at once and this queue does the
  // work, with retries; a turn that fails is retried, and it is only a database insert.
  "queues": {
    "producers": [{ "binding": "TURNS", "queue": "slack-agent-runner-turns" }],
    "consumers": [{ "queue": "slack-agent-runner-turns", "max_batch_size": 1, "max_retries": 3 }]
  },

  // Routines, channel settings and the transcript index. `npm run setup` creates the database,
  // writes its id here, and applies the SQL files in migrations/.
  "d1_databases": [
    { "binding": "DB", "database_name": "slack-agent-runner", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ],

  // Every turn's Claude transcript, uploaded by the turn itself. Kept forever: the bucket has no
  // lifecycle rule. `npm run setup` creates it.
  "r2_buckets": [{ "binding": "TRANSCRIPTS", "bucket_name": "slack-agent-runner-transcripts" }],

  // Routines (src/routines.ts): every minute the Worker fires the routines that are due. Created by
  // the deploy, which `npm run setup` runs. Minute precision is what lets a routine run that often.
  "triggers": { "crons": ["* * * * *"] },

  // The script your machine runs for each turn, and the instructions Claude reads there: shipped as
  // text so GET /runner/box can hand them over (src/box-src.ts). And the web UI's page, script and
  // styles (ui/), served by the Worker behind Cloudflare Access.
  "rules": [{ "type": "Text", "globs": ["**/box/*.md", "**/box/*.mjs", "**/ui/*.html", "**/ui/*.js", "**/ui/*.css"], "fallthrough": true }],

  // RUNNER_SECRET is the one secret this Worker needs to reach a turn: `wrangler secret put
  // RUNNER_SECRET`, the same string your machine is started with (runner/README.md).
  "vars": {
    // How long one Claude turn may run, counted from when the thread started the turn.
    "MAX_TURN_MINUTES": "45",
    // How long a thread may sit quiet before the alarm records it as paused.
    "IDLE_PAUSE_MINUTES": "5",
    // The bot's memory: a private GitHub repo, owner/name, with the GitHub App installed on it.
    // One folder per Slack channel (src/memory.ts). `npm run setup` sets this for you.
    "MEMORY_REPO": "",
    // The web UI (/ui) sits on its own host behind Cloudflare Access, and the Worker checks Access's
    // JWT too. UI_HOST is that host (the custom domain in "routes"); then your Zero Trust team domain
    // (for example myteam.cloudflareaccess.com) and the Access application's AUD tag. Any of them
    // empty means the UI refuses everyone. `npm run setup` sets them (README, "Web UI").
    "UI_HOST": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // The Worker's workers.dev address. A routine made on the web UI reports back here, never to
    // UI_HOST (rule 6 in src/ui.ts). `npm run setup` writes it from the deploy output.
    "WORKER_URL": ""
  }
}
