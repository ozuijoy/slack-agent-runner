# Copy to .env.setup and fill in. .env.setup is git-ignored. Never paste these values into a chat.
# Then run: npm run setup -- --file .env.setup
# Run it again after you add a missing value. You can delete .env.setup when setup is done.

# Sandbox provider: e2b or impello
#   E2B:     https://e2b.dev/dashboard            ($100 free credit)
#   Impello: https://dashboard.impello.ai          (API Keys tab, 7-day free trial)
SANDBOX_PROVIDER=
SANDBOX_API_KEY=

# Claude: fill in ONE.
#   Your Pro/Max plan: run `claude setup-token`. Your own use only: Anthropic's terms allow a plan
#   token for your own use of Claude Code. If other people will use the bot, use an API key.
CLAUDE_CODE_OAUTH_TOKEN=
#   Or an Anthropic API key (pay per use): https://console.anthropic.com
ANTHROPIC_API_KEY=

# Slack: leave empty on the first run. Setup deploys the Worker and makes slack-manifest.local.json
# with your Worker URL in it. Create the app from that manifest, then fill these in and run again.
#   Basic Information > Signing Secret
SLACK_SIGNING_SECRET=
#   OAuth & Permissions > Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=

# GitHub App (REQUIRED): the bot keeps its memory in a GitHub repo, and the same App lets it open
# pull requests. See "GitHub App" in the README.
GITHUB_APP_ID=
# Path to the .pem file GitHub downloaded (setup reads the file; do not paste the key here).
GITHUB_APP_PRIVATE_KEY_PATH=
# Only if the App is installed on more than one account.
GITHUB_INSTALLATION_ID=
# The App's Webhook secret. Leave it empty: setup makes one and writes it here. Then copy it from
# this line into the App's Webhook settings (Webhook secret). It lets the bot follow the PRs it opens
# (README, "Following PRs"). Fill it in yourself only if the App already has a secret you chose.
GITHUB_WEBHOOK_SECRET=

# The bot's memory: a PRIVATE GitHub repo, as owner/name (for example you/my-bot-memory). Create it
# with a README, and install the GitHub App on it. Not a secret. One folder per Slack channel.
MEMORY_REPO=

# The web UI (/ui: live transcripts, routines, channel settings), optional. It needs its own hostname
# on a domain you have in Cloudflare, behind Cloudflare Access: Access cannot cover only /ui on
# workers.dev. Leave these empty on the first run. See "Web UI" in the README. Not secrets.
#   A new subdomain for the UI, for example agent.example.com. Setup attaches it to the Worker.
UI_HOST=
#   Zero Trust > Settings: the team domain, <team>.cloudflareaccess.com
ACCESS_TEAM_DOMAIN=
#   Zero Trust > Access > Applications > your app > Overview: Application Audience (AUD) Tag
ACCESS_AUD=
