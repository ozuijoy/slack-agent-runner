{
  "name": "slack-agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "@mention it in Slack and it runs Claude Code on your own machine, then replies in the thread. The Worker is on Cloudflare; the turns are not.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "setup": "node --experimental-strip-types --no-warnings scripts/setup.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "runner": "node runner/runner-daemon.mjs",
    "scan": "node scripts/scan-private-names.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
