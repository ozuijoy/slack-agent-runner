{
  "name": "slack-agent-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "@mention it in Slack and it runs Claude Code in a cloud sandbox, then replies in the thread. Runs on Cloudflare Workers.",
  "license": "MIT",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "setup": "node --experimental-strip-types --no-warnings scripts/setup.mjs",
    "template:build": "node --experimental-strip-types --no-warnings scripts/build-template.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "scan": "node scripts/scan-private-names.mjs"
  },
  "dependencies": {
    "@impello/sdk": "0.3.1",
    "e2b": "2.55.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "wrangler": "4.152.0"
  }
}
